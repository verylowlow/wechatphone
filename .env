ALIYUN_REALTIME_API_KEY=sk-7b5440eb607b4bb0a11595ba0472f6c5
ALIYUN_REALTIME_BASE_URL=https://llm-eef79bxxd42lvkdz.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
ALIYUN_REALTIME_VOICE=longanqian
# 可选: 复刻音色 ID（来自 newcallcall 项目）
# ALIYUN_REALTIME_VOICE=qwen-audio-3.0-realtime-plus-myvoice-d911a3b45ebf48279e9efbf64dd50b47
# 交互模式: server_vad(官方demo默认,参数可控,推荐先用这个诊断) | smart_turn(语义轮次)
ALIYUN_TURN_DETECTION=server_vad
# server_vad 参数 (smart_turn 模式下无效)
ALIYUN_VAD_THRESHOLD=0.5
ALIYUN_SILENCE_DURATION_MS=800
# 噪声门: AI说话期间, 平均振幅低于此值的音频块不上行 (官方demo默认500)
ALIYUN_NOISE_GATE=500

# ---------------- 通话记录 ----------------
# 总开关 (0=关闭); 数据落 data/calls.sqlite, 页面: python calllog_app.py (默认 :8766)
CALLLOG_ENABLED=1
# 外呼(autodial)开场: 任务注入后多少秒无人出声, 让 AI 先开口
OUTBOUND_OPEN_DELAY=5
# ---------------- 开场白 ----------------
# 来电开场白: AI 自动接听来电后第一句说的话 (固定文案, 在此配置)
INCOMING_GREETING=您好, 电话已经接通了, 请问有什么事吗?
# 外呼开场白默认值: 任务发起人未指定 --opening/JSON opening 字段时的回退
OUTBOUND_DEFAULT_OPENING=您好, 我是这边负责跟进的工作人员, 打扰您几分钟。
# 来电自动接听: 1=开启; 检测到微信来电弹窗自动点接听, 接通后 AI 主动开口
AUTO_ANSWER=1
# 是否连视频通话也自动接听 (默认 0=只接语音, 视频来电跳过)
AUTO_ANSWER_VIDEO=0
# 来电弹窗轮询间隔(秒)
AUTO_ANSWER_POLL=1.0

# ---------------- 语音消息 (voice_msg / sendvoice) ----------------
# 主引擎: volc=豆包 Seed TTS (原生接口 X-Api-Key, 2026-08-13 调通) / edge=免费无需 key
TTS_ENGINE=volc
# volc 失败(401/超时/网络)自动降级 edge 免费兜底
TTS_FALLBACK_ENABLED=1
# edge 兜底音色 (sendvoice --list-voices 可查中文音色)
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# 豆包 Seed TTS 配置 (火山引擎新版控制台, X-Api-Key 鉴权)
TTS_ENABLED=1
TTS_API_KEY=89beb6a9-8eb5-40c9-9ea2-f7450c15e40a
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# X-Api-Resource-Id: uranus 音色(2.0)必须配 seed-tts-2.0;
# 若换 *_mars_bigtts/*_moon_bigtts(1.0) 音色需改回 seed-tts-1.0, 复刻音色(S_开头)用 seed-icl-2.0
TTS_MODEL=seed-tts-1.0
#TTS_MODEL=seed-tts-2.0
# 备选音色: 切换时把下面两行注释互换即可
#TTS_VOICE=zh_female_jiaochuannv_uranus_bigtts
TTS_VOICE=zh_female_jiaochuan_mars_bigtts
#TTS_VOICE=zh_female_tvbnv_uranus_bigtts
TTS_SPEED=1.0
# TTS 请求超时(秒); 超时/失败直接报错, 不会触碰微信
TTS_TIMEOUT=30
# 发送时序余量(毫秒): 开录音后多少ms开始播 / 播完后多少ms点发送 (调参用)
VOICE_REC_START_MS=250
VOICE_TAIL_MS=250

# ---------------- 知识库 ----------------
# 总开关 (0=关闭, 通话不带知识库)
KNOWLEDGE_ENABLED=1
# 后端: local=SQLite+numpy嵌入式混合检索(默认); 后续可扩展 ragflow/chroma
KNOWLEDGE_BACKEND=local
# 向量化: DashScope OpenAI 兼容接口 (与 newcallcall 相同); 留空则自动降级为哈希向量
KNOWLEDGE_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KNOWLEDGE_EMBEDDING_API_KEY=sk-7b5440eb607b4bb0a11595ba0472f6c5
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
